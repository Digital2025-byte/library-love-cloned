# FlyCham CMS backend — production runtime environment (Hostinger VPS)
# Copy to `.env.production` for the build, and set the same values in the process
# manager (PM2 ecosystem / systemd) so the running server has them too.
#
# These are read at runtime by the API routes:
#   process.env.SUPABASE_URL || import.meta.env.VITE_SUPABASE_URL
# The publishable key is a PUBLIC key (safe on the client); it is NOT the
# service_role key. Writes are authorized by the caller's Supabase bearer token
# + row-level security, so no service_role key is needed on this server.

# --- Supabase (the CMS database) ---
SUPABASE_URL=https://xbqrfakpcisqunyugrqt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_DVuilPL7OZyKMZ266JYJGA_eEaVyfpL

# Baked into the build at build time (Vite). Keep them equal to the two above.
VITE_SUPABASE_URL=https://xbqrfakpcisqunyugrqt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_DVuilPL7OZyKMZ266JYJGA_eEaVyfpL

# --- Node server (nitro node-server preset) ---
# Bind to localhost only; nginx terminates TLS and proxies to it.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
