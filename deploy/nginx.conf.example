# FlyCham CMS backend — nginx reverse proxy
# Save as: /etc/nginx/sites-available/flycham-cms
# Enable:  ln -s /etc/nginx/sites-available/flycham-cms /etc/nginx/sites-enabled/
# Test:    nginx -t && systemctl reload nginx
# Later, with a domain, add TLS: certbot --nginx -d cms.yourdomain.com

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;   # matches the raw IP 191.215.44.115; swap for a domain later

    # CORS is handled by the CMS app itself (Access-Control-Allow-Origin: *),
    # so nothing extra is needed here.

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
